# ==========================================================================
# FILE CẤU HÌNH TÙY CHỌN – HỌC SINH KHÔNG CẦN TẠO FILE .env!
#
# Mọi thứ đã được chọn sẵn trong config.py, Pi chạy được ngay không cần file này.
# Chỉ khi nào muốn ĐỔI một giá trị thì mới sao chép file này thành ".env"
# rồi bỏ dấu # ở đầu dòng muốn đổi.
# ==========================================================================

# Địa chỉ server. Mặc định "auto": Pi tự tìm server trong mạng.
# Muốn chỉ định cứng (ví dụ server ở mạng Tailscale):
# MAC_SERVER_URL=http://100.65.39.52:8080

# Mật khẩu chung với server (mặc định đã khớp, thường không đổi).
# SERVER_TOKEN=d26a5af4e93257eda0aeb44d0db6da1f

# Chân GPIO của nút bấm (mặc định 25 = chân vật lí số 22).
# TOUCH_GPIO=25
# Nút nối xuống GND (mặc định): false.  Cảm biến chạm TTP223: true.
# TOUCH_ACTIVE_HIGH=false

# Chế độ liên tục có tự bật khi khởi động không (mặc định true).
# START_ACTIVE=true
# Nghỉ bao nhiêu giây giữa hai lần chụp (mặc định 1).
# LOOP_INTERVAL_SECONDS=1

# Cố định lấy nét camera (3.5 = khoảng 28 cm). Để trống = tự lấy nét.
# LENS_POSITION=
