# Mac server đã có (Hummingbird + Gemini + TTS), truy cập qua Tailscale.
MAC_SERVER_URL=https://your-mac.tailnet.ts.net
SERVER_TOKEN=replace-me

# Thiết bị ALSA của loa MAX98357A ("default" nếu nó là card mặc định).
ONBOARD_PLAYBACK_DEVICE=default

# Cảm biến chạm điện dung (TTP223...): số GPIO (BCM), không phải số chân vật lí.
# GPIO25 = chân vật lí 22. Tránh GPIO18/19/21 (I2S của MAX98357A).
TOUCH_GPIO=25
# true: ngõ ra mức cao khi chạm (TTP223). false: nút nhấn nối GND.
TOUCH_ACTIVE_HIGH=true

# Camera Module 3: để trống = tự lấy nét. Điền 3.5 để cố định lấy nét ~28 cm (chưa kiểm chứng).
LENS_POSITION=

# /command gọi Gemini + TTS nên có thể lâu.
COMMAND_TIMEOUT_SECONDS=60
HTTP_RETRIES=2
