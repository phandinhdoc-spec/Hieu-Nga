# ==========================================================================
# CẤU HÌNH SERVER. Sao chép file này thành ".env" rồi điền chìa khóa Gemini.
# Dòng bắt đầu bằng # là chú thích, máy bỏ qua.
# ==========================================================================

# --- BẮT BUỘC -------------------------------------------------------------
# Chìa khóa Gemini (lấy MIỄN PHÍ tại https://aistudio.google.com/apikey).
GEMINI_API_KEY=dán-chìa-khóa-vào-đây

# --- TÙY CHỌN (đã chọn sẵn, thường không đổi) ----------------------------
# Mật khẩu chung với Pi. Đã ghi sẵn cả hai bên nên để trống/không cần dòng này.
# SERVER_TOKEN=d26a5af4e93257eda0aeb44d0db6da1f

GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_BUDGET=0         # 0 = tắt "suy nghĩ" cho nhanh; để trống nếu model không hỗ trợ
GEMINI_TIMEOUT_SECONDS=40        # chờ Gemini tối đa bao nhiêu giây
TTS_VOICE=vi-VN-HoaiMyNeural     # giọng nữ; giọng nam: vi-VN-NamMinhNeural
TTS_ON_OBSERVE=false             # giữ false: Pi không dùng tiếng này, bật chỉ tốn thời gian
HOST=0.0.0.0                     # nhận kết nối từ mọi máy trong mạng
PORT=8080                        # số cổng
